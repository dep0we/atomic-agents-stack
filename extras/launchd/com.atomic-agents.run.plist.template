<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: run one Atomic Agent on a daily schedule.

  Replace every __KEY__ placeholder before loading.
  See README.md in this directory for guidance.

  ── API key security ─────────────────────────────────────────────────────
  This template does NOT include an API key in EnvironmentVariables.
  The recommended path is macOS Keychain:

    security add-generic-password \
      -a "$USER" \
      -s "atomic-agents-anthropic" \
      -w "sk-ant-..."

  The atomic_agents package key loader checks Keychain automatically — no
  env var required, and the key never appears in the plist file, in
  `launchctl print` output, or in process metadata visible to other users.

  If you prefer env-var delivery (less secure — see README.md for
  trade-offs), add the key block to EnvironmentVariables manually:
      <key>ANTHROPIC_API_KEY</key>
      <string>sk-ant-...</string>
  but understand that anyone who can read ~/Library/LaunchAgents/ or run
  `launchctl print gui/$UID/<label>` can see the key in plaintext.
  ─────────────────────────────────────────────────────────────────────────

  After substitution:
    cp this-file ~/Library/LaunchAgents/__LABEL__.plist
    launchctl load ~/Library/LaunchAgents/__LABEL__.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <!-- The command. Two patterns:
         1) Direct python:        ProgramArguments = [python, -m, atomic_agents.cli, run, ...]
         2) uv-run wrapper:       ProgramArguments = [uv, run, atomic-agents, run, ...]
                                  + WorkingDirectory = __PROJECT_DIR__
    -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON_BIN__</string>
        <string>-m</string>
        <string>atomic_agents.cli</string>
        <string>run</string>
        <string>__AGENT_NAME__</string>
        <string>--trigger</string>
        <string>cron</string>
        <string>--work-item</string>
        <string>__WORK_ITEM__</string>
    </array>

    <!-- Required so the agent finds your vault. Either set it here or rely on the
         user's shell profile (which launchd does NOT source).
         API key is intentionally absent — loaded from Keychain at runtime.
         See the comment block at the top of this file for the trade-offs. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>ATOMIC_AGENTS_ROOT</key>
        <string>__AGENTS_ROOT__</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>

    <!-- Schedule: run once a day at __HOUR__:__MINUTE__. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Don't restart if the agent exits successfully. -->
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <!-- Logs. Create __LOG_DIR__ before loading or the job will silently fail. -->
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/run-__AGENT_NAME__.out</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/run-__AGENT_NAME__.err</string>
</dict>
</plist>
